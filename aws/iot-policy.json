{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:us-east-1:ACCOUNT_ID:client/psi5120-final-jmr-device01"
    },
    {
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": [
        "arn:aws:iot:us-east-1:ACCOUNT_ID:topic/psi5120/final/psi5120-final-jmr-device01/telemetry",
        "arn:aws:iot:us-east-1:ACCOUNT_ID:topic/$aws/things/psi5120-final-jmr-device01/shadow/update"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": [
        "arn:aws:iot:us-east-1:ACCOUNT_ID:topicfilter/psi5120/final/psi5120-final-jmr-device01/command",
        "arn:aws:iot:us-east-1:ACCOUNT_ID:topicfilter/$aws/things/psi5120-final-jmr-device01/shadow/update/delta"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:Receive",
      "Resource": [
        "arn:aws:iot:us-east-1:ACCOUNT_ID:topic/psi5120/final/psi5120-final-jmr-device01/command",
        "arn:aws:iot:us-east-1:ACCOUNT_ID:topic/$aws/things/psi5120-final-jmr-device01/shadow/update/delta"
      ]
    }
  ]
}
